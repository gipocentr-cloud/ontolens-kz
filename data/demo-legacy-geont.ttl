@prefix :        <http://ontogeo.kz/geont-kz#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix ifc:     <http://www.buildingsmart-tech.org/ifcOWL/IFC4#> .
@prefix geocore: <http://www.geoscience.org/geocore#> .
@prefix ontolex: <http://www.w3.org/ns/lemon/ontolex#> .

##############################################################################
#
#    Ontology
#
##############################################################################

<http://ontogeo.kz/geont-kz> rdf:type owl:Ontology ;
    owl:imports <http://www.w3.org/2004/02/skos/core> ;
    owl:imports <http://www.buildingsmart-tech.org/ifcOWL/IFC4> ;
    owl:versionInfo "0.4-demo-defective" ;
    rdfs:label "GeOnt-KZ (СИНТЕТИЧЕСКИЙ ДЕФЕКТНЫЙ ДЕМОНАБОР)"@ru ;
    rdfs:comment "ВНИМАНИЕ: сгенерировано build/make_demo_data.py. Набор намеренно воспроизводит типы дефектов, найденные в настоящем GeOnt-KZ.ttl (тег kz вместо kk, классы-сироты, множественные родители, провенанс литералом, свойства без домена и диапазона, категориальные ошибки иерархии). Определения вымышлены."@ru .


##############################################################################
#
#    Object Properties
#
##############################################################################

###  http://ontogeo.kz/geont-kz#hasSoilType
:hasSoilType rdf:type owl:ObjectProperty ;
    rdfs:domain :Soil ;
    rdfs:range :Soil ;
    rdfs:label "тип грунта"@kz .

###  http://ontogeo.kz/geont-kz#hasStrength
:hasStrength rdf:type owl:ObjectProperty ;
    rdfs:label "прочность"@kz .

###  http://ontogeo.kz/geont-kz#hasIceContent
:hasIceContent rdf:type owl:ObjectProperty .

###  http://ontogeo.kz/geont-kz#isLocatedIn
:isLocatedIn rdf:type owl:ObjectProperty ;
    rdfs:domain :Borehole ;
    rdfs:label "расположен в"@kz .

###  http://ontogeo.kz/geont-kz#hasTestResult
:hasTestResult rdf:type owl:ObjectProperty ;
    rdfs:range :FieldTest .

###  http://ontogeo.kz/geont-kz#relatesToDocument
:relatesToDocument rdf:type owl:ObjectProperty .

###  http://ontogeo.kz/geont-kz#hasSubsoil
:hasSubsoil rdf:type owl:ObjectProperty ;
    rdfs:domain :Foundation ;
    rdfs:range :Soil .

###  http://ontogeo.kz/geont-kz#measuredAt
:measuredAt rdf:type owl:ObjectProperty ;
    rdfs:label "измерено на"@kz .


##############################################################################
#
#    Data Properties
#
##############################################################################

###  http://ontogeo.kz/geont-kz#hasValue
:hasValue rdf:type owl:DatatypeProperty ;
    rdfs:label "значение"@ru .

###  http://ontogeo.kz/geont-kz#hasUnit
:hasUnit rdf:type owl:DatatypeProperty .

###  http://ontogeo.kz/geont-kz#hasDepth
:hasDepth rdf:type owl:DatatypeProperty ;
    rdfs:label "глубина"@ru .


##############################################################################
#
#    Classes
#
##############################################################################

###  http://ontogeo.kz/geont-kz#GeotechnicalEntity
:GeotechnicalEntity rdf:type owl:Class ;
    rdfs:label "GeotechnicalEntity"@en .

###  http://ontogeo.kz/geont-kz#GeotechnicalProperty
:GeotechnicalProperty rdf:type owl:Class ;
    rdfs:label "GeotechnicalProperty"@en .

###  http://ontogeo.kz/geont-kz#GeotechnicalWork
:GeotechnicalWork rdf:type owl:Class ;
    rdfs:label "GeotechnicalWork"@en .

###  http://ontogeo.kz/geont-kz#StructuralEntity
:StructuralEntity rdf:type owl:Class ;
    rdfs:label "StructuralEntity"@en .

###  http://ontogeo.kz/geont-kz#FieldTest
:FieldTest rdf:type owl:Class ;
    rdfs:label "FieldTest"@en .

###  http://ontogeo.kz/geont-kz#FieldWork
:FieldWork rdf:type owl:Class ;
    rdfs:label "FieldWork"@en .

###  http://ontogeo.kz/geont-kz#SeismicEntity
:SeismicEntity rdf:type owl:Class ;
    rdfs:label "SeismicEntity"@en .

###  http://ontogeo.kz/geont-kz#LimitState
:LimitState rdf:type owl:Class ;
    rdfs:label "LimitState"@en .

###  http://ontogeo.kz/geont-kz#LoadEntity
:LoadEntity rdf:type owl:Class ;
    rdfs:label "LoadEntity"@en .

###  http://ontogeo.kz/geont-kz#QualityEntity
:QualityEntity rdf:type owl:Class ;
    rdfs:label "QualityEntity"@en .

###  http://ontogeo.kz/geont-kz#Deformation
:Deformation rdf:type owl:Class ;
    rdfs:label "Deformation"@en .

###  http://ontogeo.kz/geont-kz#Geotechnical_category
:Geotechnical_category rdf:type owl:Class ;
    rdfs:label "geotechnical category"@ru ;
    rdfs:label "geotechnical category"@kz .

###  http://ontogeo.kz/geont-kz#Soil_classification_system
:Soil_classification_system rdf:type owl:Class ;
    rdfs:label "soil classification system"@ru ;
    rdfs:label "soil classification system"@kz .

###  http://ontogeo.kz/geont-kz#Laboratory_test
:Laboratory_test rdf:type owl:Class ;
    rdfs:label "laboratory test"@ru ;
    rdfs:label "laboratory test"@kz .

###  http://ontogeo.kz/geont-kz#Engineering_geology
:Engineering_geology rdf:type owl:Class ;
    rdfs:label "engineering geology"@ru ;
    rdfs:label "engineering geology"@kz .

###  http://ontogeo.kz/geont-kz#Hydrogeology
:Hydrogeology rdf:type owl:Class ;
    rdfs:label "hydrogeology"@ru ;
    rdfs:label "hydrogeology"@kz .

###  http://ontogeo.kz/geont-kz#Groundwater_level
:Groundwater_level rdf:type owl:Class .

###  http://ontogeo.kz/geont-kz#Site_investigation_report
:Site_investigation_report rdf:type owl:Class .

###  http://ontogeo.kz/geont-kz#Soil
:Soil rdf:type owl:Class ;
    rdfs:subClassOf :GeotechnicalEntity ;
    rdfs:label "грунт"@ru ;
    rdfs:label "топырақ"@kz ;
    rdfs:comment "любая горная порода, почва или техногенное образование"@ru ;
    rdfs:comment "любая горная порода, почва или техногенное образование"@kz ;
    rdfs:isDefinedBy "СН РК 5.01-01-2013" .

###  http://ontogeo.kz/geont-kz#Clay_soil
:Clay_soil rdf:type owl:Class ;
    rdfs:subClassOf :Soil ;
    rdfs:label "глинистый грунт"@ru ;
    rdfs:label "сазды топырақ"@kz ;
    rdfs:comment "связный грунт с числом пластичности более единицы"@ru ;
    rdfs:comment "связный грунт с числом пластичности более единицы"@kz ;
    rdfs:isDefinedBy "СН РК 5.01-01-2013" .

###  http://ontogeo.kz/geont-kz#Sandy_soil
:Sandy_soil rdf:type owl:Class ;
    rdfs:subClassOf :Soil ;
    rdfs:label "песчаный грунт"@ru ;
    rdfs:label "құмды топырақ"@kz ;
    rdfs:comment "несвязный грунт, содержащий менее 50 % частиц крупнее 2 мм"@ru ;
    rdfs:comment "несвязный грунт, содержащий менее 50 % частиц крупнее 2 мм"@kz ;
    rdfs:isDefinedBy "СН РК 5.01-01-2013" .

###  http://ontogeo.kz/geont-kz#Anthropogenic_soil
:Anthropogenic_soil rdf:type owl:Class ;
    rdfs:subClassOf :Soil ;
    rdfs:label "антропогенный грунт"@ru ;
    rdfs:label "антропогендік топырақ"@kz ;
    rdfs:comment "грунт, образованный в результате хозяйственной деятельности"@ru ;
    rdfs:comment "грунт, образованный в результате хозяйственной деятельности"@kz ;
    rdfs:isDefinedBy "СН РК 5.01-01-2013" .

###  http://ontogeo.kz/geont-kz#Frozen_soil
:Frozen_soil rdf:type owl:Class ;
    rdfs:subClassOf :Soil ;
    rdfs:label "мёрзлый грунт"@ru ;
    rdfs:label "тоңды топырақ"@kz ;
    rdfs:comment "грунт, имеющий отрицательную температуру и содержащий лёд"@ru ;
    rdfs:comment "грунт, имеющий отрицательную температуру и содержащий лёд"@kz ;
    rdfs:isDefinedBy "СП РК 5.01-102-2013" .

###  http://ontogeo.kz/geont-kz#Permafrost
:Permafrost rdf:type owl:Class ;
    rdfs:subClassOf :Frozen_soil ;
    rdfs:label "многолетнемёрзлый грунт"@ru ;
    rdfs:label "көпжылдық тоңды топырақ"@kz ;
    rdfs:comment "грунт, находящийся в мёрзлом состоянии не менее трёх лет"@ru ;
    rdfs:comment "грунт, находящийся в мёрзлом состоянии не менее трёх лет"@kz ;
    rdfs:isDefinedBy "СП РК 5.01-102-2013" .

###  http://ontogeo.kz/geont-kz#Loess
:Loess rdf:type owl:Class ;
    rdfs:subClassOf :Clay_soil ;
    rdfs:label "лёссовый грунт"@ru ;
    rdfs:label "лёсс топырағы"@kz ;
    rdfs:comment "пылеватый грунт, обладающий просадочностью при замачивании"@ru ;
    rdfs:comment "пылеватый грунт, обладающий просадочностью при замачивании"@kz ;
    rdfs:isDefinedBy "СН РК 5.01-01-2013" .

###  http://ontogeo.kz/geont-kz#Subsidence
:Subsidence rdf:type owl:Class ;
    rdfs:subClassOf :Deformation ;
    rdfs:label "просадка"@ru ;
    rdfs:label "шөгу"@kz ;
    rdfs:comment "деформация основания, возникающая при замачивании просадочного грунта"@ru ;
    rdfs:comment "деформация основания, возникающая при замачивании просадочного грунта"@kz ;
    rdfs:isDefinedBy "СН РК 5.01-01-2013" .

###  http://ontogeo.kz/geont-kz#Settlement_geotech
:Settlement_geotech rdf:type owl:Class ;
    rdfs:subClassOf :Deformation ;
    rdfs:label "осадка"@ru ;
    rdfs:label "отыру"@kz ;
    rdfs:comment "вертикальная деформация основания под нагрузкой"@ru ;
    rdfs:comment "вертикальная деформация основания под нагрузкой"@kz ;
    rdfs:isDefinedBy "СН РК 5.01-01-2013" .

###  http://ontogeo.kz/geont-kz#Heave
:Heave rdf:type owl:Class ;
    rdfs:subClassOf :Deformation ;
    rdfs:label "пучение"@ru ;
    rdfs:label "көтерілу"@kz ;
    rdfs:comment "подъём поверхности грунта при промерзании"@ru ;
    rdfs:comment "подъём поверхности грунта при промерзании"@kz ;
    rdfs:isDefinedBy "СП РК 5.01-102-2013" .

###  http://ontogeo.kz/geont-kz#Bearing_capacity
:Bearing_capacity rdf:type owl:Class ;
    rdfs:subClassOf :GeotechnicalProperty ;
    rdfs:label "несущая способность"@ru ;
    rdfs:label "көтергіш қабілет"@kz ;
    rdfs:isDefinedBy "СН РК 5.01-01-2013" .

###  http://ontogeo.kz/geont-kz#Youngs_modulus
:Youngs_modulus rdf:type owl:Class ;
    rdfs:subClassOf :GeotechnicalProperty ;
    rdfs:label "модуль деформации"@ru ;
    rdfs:label "серпімділік модулі (бірінші типтегі серпімділік модулі)"@kz ;
    rdfs:comment "отношение приращения напряжения к приращению относительной деформации"@ru ;
    rdfs:comment "отношение приращения напряжения к приращению относительной деформации"@kz ;
    rdfs:isDefinedBy "ГОСТ 12248-2010" .

###  http://ontogeo.kz/geont-kz#Poisson_ratio
:Poisson_ratio rdf:type owl:Class ;
    rdfs:subClassOf :GeotechnicalProperty ;
    rdfs:label "коэффициент Пуассона"@ru ;
    rdfs:label "Пуассон коэффициенті"@kz ;
    rdfs:comment "отношение поперечной деформации к продольной"@ru ;
    rdfs:comment "отношение поперечной деформации к продольной"@kz ;
    rdfs:isDefinedBy "ГОСТ 12248-2010" .

###  http://ontogeo.kz/geont-kz#Cohesion
:Cohesion rdf:type owl:Class ;
    rdfs:subClassOf :GeotechnicalProperty ;
    rdfs:label "удельное сцепление"@ru ;
