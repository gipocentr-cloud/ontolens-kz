##############################################################################
#
#    Bridges
#
##############################################################################

:Foundation rdfs:subClassOf ifc:IfcFooting .
:Pile rdfs:subClassOf ifc:IfcPile .
:Retaining_wall rdfs:subClassOf ifc:IfcWall .
:Borehole rdfs:subClassOf geocore:Borehole .
:Soil rdfs:subClassOf geocore:GeologicUnit .


