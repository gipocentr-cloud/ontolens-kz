    rdfs:comment "характеристика прочности грунта на сдвиг при нулевом нормальном напряжении"@kz ;
    rdfs:isDefinedBy "ГОСТ 12248-2010" .

###  http://ontogeo.kz/geont-kz#Friction_angle
:Friction_angle rdf:type owl:Class ;
    rdfs:subClassOf :GeotechnicalProperty ;
    rdfs:label "угол внутреннего трения"@ru ;
    rdfs:label "ішкі үйкеліс бұрышы"@kz ;
