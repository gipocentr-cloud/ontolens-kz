    skos:prefLabel "3 · Нивелирные сети"@ru ;
    skos:prefLabel "3 · Levelling networks"@en ;
    skos:member :LevellingNetwork .

###  Block 04
:Block04_ControlPointsMarksAndBenchmarks rdf:type skos:Collection ;
