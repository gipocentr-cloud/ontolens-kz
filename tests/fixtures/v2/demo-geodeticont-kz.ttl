    skos:prefLabel "геодезический пункт"@ru ;
    skos:prefLabel "control point"@en .

###  http://ontogeo.kz/geodeticont-kz#Benchmark
:Benchmark rdf:type owl:Class ;
    rdfs:subClassOf :ControlPoint ;
    skos:prefLabel "репер"@ru ;
    skos:prefLabel "benchmark"@en .

###  http://ontogeo.kz/geodeticont-kz#CoordinateSystem
:CoordinateSystem rdf:type owl:Class ;
    rdfs:subClassOf :GeodeticEntity ;
    skos:prefLabel "система координат"@ru ;
    skos:prefLabel "coordinate system"@en .

###  http://ontogeo.kz/geodeticont-kz#HeightSystem
:HeightSystem rdf:type owl:Class ;
    rdfs:subClassOf :GeodeticEntity ;
    skos:prefLabel "система высот"@ru ;
    skos:prefLabel "height system"@en .

###  http://ontogeo.kz/geodeticont-kz#Instrument
:Instrument rdf:type owl:Class ;
    rdfs:subClassOf :GeodeticEntity ;
