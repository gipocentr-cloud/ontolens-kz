##############################################################################
#
#    Term classes (119) — punning owl:Class + skos:Concept
#
##############################################################################

###  http://ontogeo.kz/geodeticont-kz#GeodeticControlNetwork
:GeodeticControlNetwork rdf:type owl:Class , skos:Concept ;
    rdfs:subClassOf :ControlNetwork ;
    skos:prefLabel "геодезическая опорная сеть"@ru ;
    skos:prefLabel "geodetic control network"@en ;
    skos:prefLabel "геодезиялық тірек желісі"@kk ;
    skos:definition "система закреплённых на местности пунктов, положение которых определено в единой системе координат"@ru ;
    skos:definition "system of monumented points whose positions are determined in a common coordinate system"@en ;
    dcterms:identifier "1"^^xsd:integer ;
    rdfs:isDefinedBy doc:d01 ;
    dcterms:source doc:d01 ;
    skos:inScheme :GeodeticOntKZScheme ;
    skos:editorialNote "English label and definition: authors' translation, not source-attested"@en ;
    skos:editorialNote "Kazakh label: source-attested"@en .

###  http://ontogeo.kz/geodeticont-kz#StateGeodeticNetwork
:StateGeodeticNetwork rdf:type owl:Class , skos:Concept ;
    rdfs:subClassOf :GeodeticControlNetwork ;
    skos:prefLabel "государственная геодезическая сеть"@ru ;
    skos:prefLabel "state geodetic network"@en ;
    skos:prefLabel "мемлекеттік геодезиялық желі"@kk ;
    skos:definition "геодезическая сеть, создаваемая и поддерживаемая уполномоченным государственным органом"@ru ;
    skos:definition "geodetic network established and maintained by the authorised state body"@en ;
    dcterms:identifier "2"^^xsd:integer ;
    rdfs:isDefinedBy doc:d01 ;
    dcterms:source doc:d01 ;
    skos:inScheme :GeodeticOntKZScheme ;
    skos:editorialNote "English label and definition: authors' translation, not source-attested"@en ;
    skos:editorialNote "Kazakh label: source-attested"@en .

###  http://ontogeo.kz/geodeticont-kz#CondensationNetwork
:CondensationNetwork rdf:type owl:Class , skos:Concept ;
    rdfs:subClassOf :GeodeticControlNetwork ;
    skos:prefLabel "геодезическая сеть сгущения"@ru ;
    skos:prefLabel "densification network"@en ;
    skos:prefLabel "тығыздау желісі"@kk ;
    skos:definition "сеть, создаваемая для увеличения плотности пунктов государственной геодезической сети"@ru ;
    skos:definition "network established to increase the density of state network points"@en ;
    dcterms:identifier "3"^^xsd:integer ;
    rdfs:isDefinedBy doc:d01 ;
    dcterms:source doc:d01 ;
    skos:inScheme :GeodeticOntKZScheme ;
    skos:editorialNote "Kazakh label: expert-reviewed, not source-attested"@en .

###  http://ontogeo.kz/geodeticont-kz#SurveyJustificationNetwork
:SurveyJustificationNetwork rdf:type owl:Class , skos:Concept ;
    rdfs:subClassOf :GeodeticControlNetwork ;
    skos:prefLabel "съёмочное обоснование"@ru ;
    skos:prefLabel "survey control"@en ;
    skos:prefLabel "түсіру негіздемесі"@kk ;
    skos:definition "совокупность пунктов, служащих непосредственной основой для топографической съёмки"@ru ;
    skos:definition "set of points serving as the immediate basis for topographic survey"@en ;
    dcterms:identifier "4"^^xsd:integer ;
    rdfs:isDefinedBy doc:d02 ;
    dcterms:source doc:d02 ;
    skos:inScheme :GeodeticOntKZScheme ;
    skos:editorialNote "English label and definition: authors' translation, not source-attested"@en ;
    skos:editorialNote "Kazakh label: expert-reviewed, not source-attested"@en .

###  http://ontogeo.kz/geodeticont-kz#ConstructionGeodeticGrid
:ConstructionGeodeticGrid rdf:type owl:Class , skos:Concept ;
    rdfs:subClassOf :GeodeticControlNetwork ;
    rdfs:subClassOf ifc:IfcGrid ;
    skos:prefLabel "строительная геодезическая сетка"@ru ;
    skos:prefLabel "construction geodetic grid"@en ;
