    skos:prefLabel "structural element"@en .

###  http://ontogeo.kz/geodeticont-kz#ControlNetwork
:ControlNetwork rdf:type owl:Class ;
    rdfs:subClassOf :GeodeticEntity ;
    skos:prefLabel "геодезическая сеть"@ru ;
    skos:prefLabel "control network"@en .

###  http://ontogeo.kz/geodeticont-kz#ControlPoint
:ControlPoint rdf:type owl:Class ;
    rdfs:subClassOf :GeodeticEntity ;
