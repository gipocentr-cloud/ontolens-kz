:GeodeticOntKZScheme rdf:type skos:ConceptScheme ;
    skos:prefLabel "Тематические блоки GeodeticOnt-KZ"@ru ;
    skos:prefLabel "GeodeticOnt-KZ thematic blocks"@en .

###  Block 01
:Block01_ControlNetworks rdf:type skos:Collection ;
    skos:prefLabel "1 · Опорные сети"@ru ;
    skos:prefLabel "1 · Control networks"@en ;
    skos:member :GeodeticControlNetwork ,
        :StateGeodeticNetwork ,
        :CondensationNetwork ,
        :SurveyJustificationNetwork ,
        :ConstructionGeodeticGrid ,
        :PlanControlNetwork ,
        :HeightControlNetwork ,
        :Triangulation ,
        :Trilateration ,
        :Polygonometry ,
        :GeodeticTraverse ,
        :ClosedTraverse ,
        :NetworkOrder ,
        :NetworkAdjustment ,
        :ReferenceStationRenamed ,
        :CORSNetwork ,
        :LocalControlNetwork ,
        :NetworkDensity .

###  Block 02
:Block02_CoordinateAndHeightSystems rdf:type skos:Collection ;
    skos:prefLabel "2 · Системы координат и высот"@ru ;
    skos:prefLabel "2 · Coordinate and height systems"@en ;
    skos:member :CoordinateSystemWGS84 ,
        :NationalCoordinateSystem ,
        :LocalCoordinateSystem ,
        :ConstructionCoordinateSystem ,
        :CoordinateTransformation ,
        :MapProjection ,
        :GaussKrugerProjection ,
        :CoordinateZone ,
        :ReferenceEllipsoid ,
        :Geoid ,
        :BalticHeightSystem ,
        :AbsoluteElevation ,
        :RelativeElevation ,
        :ConditionalZero ,
        :HeightDatumTransfer .

###  Block 03
