@prefix :        <http://ontogeo.kz/geodeticont-kz#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix sh:      <http://www.w3.org/ns/shacl#> .
@prefix ifc:     <http://www.buildingsmart-tech.org/ifcOWL/IFC4#> .
@prefix geo:     <http://www.opengis.net/ont/geosparql#> .
@prefix doc:     <http://ontogeo.kz/geodeticont-kz/doc/> .

##############################################################################
#
#    Ontology
#
##############################################################################

<http://ontogeo.kz/geodeticont-kz> rdf:type owl:Ontology ;
    owl:versionIRI <http://ontogeo.kz/geodeticont-kz/0.9-demo> ;
    owl:versionInfo "0.9-demo-synthetic" ;
    dcterms:title "GeodeticOnt-KZ (СИНТЕТИЧЕСКИЙ ДЕМОНАБОР)"@ru ;
    dcterms:title "GeodeticOnt-KZ (SYNTHETIC DEMO DATASET)"@en ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:created "2026-09-20"^^xsd:date ;
    rdfs:comment "ВНИМАНИЕ: набор сгенерирован скриптом build/make_demo_data.py для проверки визуализатора OntoLens. Определения вымышлены и не являются нормативными. Реальный пакет GeodeticOnt-KZ собирается по заданию v2.2."@ru ;
    rdfs:comment "WARNING: synthetic dataset generated to exercise the OntoLens viewer. Definitions are invented and carry no normative force."@en .


##############################################################################
#
#    Object Properties
#
##############################################################################

###  http://ontogeo.kz/geodeticont-kz#regulatedBy
:regulatedBy rdf:type owl:ObjectProperty ;
    rdfs:domain :Deviation ;
    rdfs:range :RegulatoryDocument ;
    skos:prefLabel "регулируется документом"@ru ;
    skos:prefLabel "regulated by"@en .

###  http://ontogeo.kz/geodeticont-kz#appliesTo
:appliesTo rdf:type owl:ObjectProperty ;
    rdfs:domain :AccuracyRequirement ;
    rdfs:range :ConstructionObject ;
    skos:prefLabel "применяется к"@ru ;
    skos:prefLabel "applies to"@en .

###  http://ontogeo.kz/geodeticont-kz#hasMeasurement
:hasMeasurement rdf:type owl:ObjectProperty ;
    rdfs:domain :ConstructionObject ;
    rdfs:range :Measurement ;
    skos:prefLabel "имеет измерение"@ru ;
    skos:prefLabel "has measurement"@en .

###  http://ontogeo.kz/geodeticont-kz#hasTolerance
:hasTolerance rdf:type owl:ObjectProperty ;
    rdfs:domain :ConstructionObject ;
    rdfs:range :Tolerance ;
    skos:prefLabel "имеет допуск"@ru ;
    skos:prefLabel "has tolerance"@en .

###  http://ontogeo.kz/geodeticont-kz#hasDeviation
:hasDeviation rdf:type owl:ObjectProperty ;
    rdfs:domain :ConstructionObject ;
    rdfs:range :Deviation ;
    skos:prefLabel "имеет отклонение"@ru ;
    skos:prefLabel "has deviation"@en .

###  http://ontogeo.kz/geodeticont-kz#exceedsTolerance
:exceedsTolerance rdf:type owl:ObjectProperty ;
    rdfs:domain :Deviation ;
    rdfs:range :Tolerance ;
    skos:prefLabel "превышает допуск"@ru ;
    skos:prefLabel "exceeds tolerance"@en .

###  http://ontogeo.kz/geodeticont-kz#performedAtStage
:performedAtStage rdf:type owl:ObjectProperty ;
    rdfs:domain :GeodeticWork ;
    rdfs:range :ConstructionObject ;
    skos:prefLabel "выполняется на стадии"@ru ;
    skos:prefLabel "performed at stage"@en .

###  http://ontogeo.kz/geodeticont-kz#documentedBy
:documentedBy rdf:type owl:ObjectProperty ;
    rdfs:domain :GeodeticWork ;
    rdfs:range :TechnicalReport ;
    skos:prefLabel "документируется"@ru ;
    skos:prefLabel "documented by"@en .

###  http://ontogeo.kz/geodeticont-kz#providesEvidenceFor
:providesEvidenceFor rdf:type owl:ObjectProperty ;
    rdfs:domain :Measurement ;
    rdfs:range :TechnicalReport ;
    skos:prefLabel "служит подтверждением для"@ru ;
    skos:prefLabel "provides evidence for"@en .

###  http://ontogeo.kz/geodeticont-kz#linkedToBIMElement
:linkedToBIMElement rdf:type owl:ObjectProperty ;
    rdfs:domain :ConstructionObject ;
    rdfs:range ifc:IfcProduct ;
    skos:prefLabel "связан с элементом BIM"@ru ;
    skos:prefLabel "linked to BIM element"@en .

###  http://ontogeo.kz/geodeticont-kz#linkedToGISObject
:linkedToGISObject rdf:type owl:ObjectProperty ;
    rdfs:domain :ConstructionObject ;
    rdfs:range :GISObject ;
    skos:prefLabel "связан с объектом ГИС"@ru ;
    skos:prefLabel "linked to GIS object"@en .

###  http://ontogeo.kz/geodeticont-kz#duplicatesRequirement
:duplicatesRequirement rdf:type owl:ObjectProperty ;
    rdfs:domain skos:Concept ;
    rdfs:range skos:Concept ;
    skos:prefLabel "дублирует требование"@ru ;
    skos:prefLabel "duplicates requirement"@en .

###  http://ontogeo.kz/geodeticont-kz#hasLegacyEquivalent
:hasLegacyEquivalent rdf:type owl:ObjectProperty ;
    rdfs:domain skos:Concept ;
    rdfs:range skos:Concept ;
    skos:prefLabel "имеет устаревший эквивалент"@ru ;
    skos:prefLabel "has legacy equivalent"@en .

###  http://ontogeo.kz/geodeticont-kz#replacesTerm
:replacesTerm rdf:type owl:ObjectProperty ;
    rdfs:domain skos:Concept ;
    rdfs:range skos:Concept ;
    skos:prefLabel "заменяет термин"@ru ;
    skos:prefLabel "replaces term"@en .

###  http://ontogeo.kz/geodeticont-kz#hasCoordinateSystem
:hasCoordinateSystem rdf:type owl:ObjectProperty ;
    rdfs:domain :ControlNetwork ;
    rdfs:range :CoordinateSystem ;
    skos:prefLabel "имеет систему координат"@ru ;
    skos:prefLabel "has coordinate system"@en .

###  http://ontogeo.kz/geodeticont-kz#hasHeightSystem
:hasHeightSystem rdf:type owl:ObjectProperty ;
    rdfs:domain :ControlNetwork ;
    rdfs:range :HeightSystem ;
    skos:prefLabel "имеет систему высот"@ru ;
    skos:prefLabel "has height system"@en .

###  http://ontogeo.kz/geodeticont-kz#hasAccuracyRequirement
:hasAccuracyRequirement rdf:type owl:ObjectProperty ;
    rdfs:domain :GeodeticWork ;
    rdfs:range :AccuracyRequirement ;
    skos:prefLabel "имеет требование точности"@ru ;
    skos:prefLabel "has accuracy requirement"@en .

###  http://ontogeo.kz/geodeticont-kz#generatedFromSurvey
:generatedFromSurvey rdf:type owl:ObjectProperty ;
    rdfs:domain :CartographicProduct ;
    rdfs:range :AsBuiltSurvey ;
    skos:prefLabel "получен из съёмки"@ru ;
    skos:prefLabel "generated from survey"@en .


##############################################################################
#
#    Data Properties
#
##############################################################################

###  http://ontogeo.kz/geodeticont-kz#measuredValue
:measuredValue rdf:type owl:DatatypeProperty ;
    rdfs:domain :Deviation ;
    rdfs:range xsd:decimal ;
    skos:prefLabel "измеренное значение"@ru ;
    skos:prefLabel "measured value"@en .

###  http://ontogeo.kz/geodeticont-kz#permittedValue
:permittedValue rdf:type owl:DatatypeProperty ;
    rdfs:domain :Tolerance ;
    rdfs:range xsd:decimal ;
    skos:prefLabel "допустимое значение"@ru ;
    skos:prefLabel "permitted value"@en .

###  http://ontogeo.kz/geodeticont-kz#toleranceValue
:toleranceValue rdf:type owl:DatatypeProperty ;
    rdfs:domain :Tolerance ;
    rdfs:range xsd:decimal ;
    skos:prefLabel "значение допуска"@ru ;
    skos:prefLabel "tolerance value"@en .

###  http://ontogeo.kz/geodeticont-kz#unitOfMeasurement
:unitOfMeasurement rdf:type owl:DatatypeProperty ;
    rdfs:domain :Measurement ;
    rdfs:range xsd:string ;
    skos:prefLabel "единица измерения"@ru ;
    skos:prefLabel "unit of measurement"@en .

###  http://ontogeo.kz/geodeticont-kz#accuracyClass
:accuracyClass rdf:type owl:DatatypeProperty ;
    rdfs:domain :AccuracyRequirement ;
    rdfs:range xsd:string ;
    skos:prefLabel "класс точности"@ru ;
    skos:prefLabel "accuracy class"@en .

###  http://ontogeo.kz/geodeticont-kz#coordinateValueX
:coordinateValueX rdf:type owl:DatatypeProperty ;
    rdfs:domain :ControlPoint ;
    rdfs:range xsd:decimal ;
    skos:prefLabel "координата X"@ru ;
    skos:prefLabel "coordinate value X"@en .

###  http://ontogeo.kz/geodeticont-kz#coordinateValueY
:coordinateValueY rdf:type owl:DatatypeProperty ;
    rdfs:domain :ControlPoint ;
    rdfs:range xsd:decimal ;
    skos:prefLabel "координата Y"@ru ;
    skos:prefLabel "coordinate value Y"@en .

###  http://ontogeo.kz/geodeticont-kz#elevationValue
:elevationValue rdf:type owl:DatatypeProperty ;
    rdfs:domain :ControlPoint ;
    rdfs:range xsd:decimal ;
    skos:prefLabel "отметка"@ru ;
    skos:prefLabel "elevation value"@en .

###  http://ontogeo.kz/geodeticont-kz#measurementDate
:measurementDate rdf:type owl:DatatypeProperty ;
    rdfs:domain :Measurement ;
    rdfs:range xsd:date ;
    skos:prefLabel "дата измерения"@ru ;
    skos:prefLabel "measurement date"@en .

###  http://ontogeo.kz/geodeticont-kz#clauseNumber
:clauseNumber rdf:type owl:DatatypeProperty ;
    rdfs:domain :RegulatoryDocument ;
    rdfs:range xsd:string ;
    skos:prefLabel "пункт документа"@ru ;
    skos:prefLabel "clause number"@en .

###  http://ontogeo.kz/geodeticont-kz#documentStatus
:documentStatus rdf:type owl:DatatypeProperty ;
    rdfs:domain :RegulatoryDocument ;
    rdfs:range xsd:string ;
    skos:prefLabel "статус документа"@ru ;
    skos:prefLabel "document status"@en .

###  http://ontogeo.kz/geodeticont-kz#documentYear
:documentYear rdf:type owl:DatatypeProperty ;
    rdfs:domain :RegulatoryDocument ;
    rdfs:range xsd:gYear ;
    skos:prefLabel "год документа"@ru ;
    skos:prefLabel "document year"@en .

###  http://ontogeo.kz/geodeticont-kz#canBeFormalizedAsRule
:canBeFormalizedAsRule rdf:type owl:DatatypeProperty ;
    rdfs:domain :AccuracyRequirement ;
    rdfs:range xsd:boolean ;
    skos:prefLabel "формализуемо как правило"@ru ;
    skos:prefLabel "can be formalized as rule"@en .


##############################################################################
#
#    External class stubs (bridge targets, no owl:imports)
#
##############################################################################

geo:Feature rdf:type owl:Class .
geo:SpatialObject rdf:type owl:Class .
ifc:IfcAnnotation rdf:type owl:Class .
ifc:IfcBuildingElement rdf:type owl:Class .
ifc:IfcGrid rdf:type owl:Class .
ifc:IfcProduct rdf:type owl:Class .


##############################################################################
#
#    Structural classes (27)
#
##############################################################################

###  http://ontogeo.kz/geodeticont-kz#GeodeticEntity
:GeodeticEntity rdf:type owl:Class ;
    skos:prefLabel "геодезическая сущность"@ru ;
    skos:prefLabel "geodetic entity"@en .

###  http://ontogeo.kz/geodeticont-kz#GeodeticWork
:GeodeticWork rdf:type owl:Class ;
    rdfs:subClassOf :GeodeticEntity ;
    skos:prefLabel "геодезические работы"@ru ;
    skos:prefLabel "geodetic work"@en .

###  http://ontogeo.kz/geodeticont-kz#MeasurementMethod
:MeasurementMethod rdf:type owl:Class ;
    rdfs:subClassOf :GeodeticWork ;
    skos:prefLabel "метод измерений"@ru ;
    skos:prefLabel "measurement method"@en .

###  http://ontogeo.kz/geodeticont-kz#SettingOutWork
:SettingOutWork rdf:type owl:Class ;
    rdfs:subClassOf :GeodeticWork ;
    skos:prefLabel "разбивочные работы"@ru ;
    skos:prefLabel "setting-out work"@en .

###  http://ontogeo.kz/geodeticont-kz#AsBuiltSurvey
:AsBuiltSurvey rdf:type owl:Class ;
    rdfs:subClassOf :GeodeticWork ;
    skos:prefLabel "исполнительная съёмка"@ru ;
    skos:prefLabel "as-built survey"@en .

###  http://ontogeo.kz/geodeticont-kz#DeformationMonitoring
:DeformationMonitoring rdf:type owl:Class ;
    rdfs:subClassOf :GeodeticWork ;
    skos:prefLabel "мониторинг деформаций"@ru ;
    skos:prefLabel "deformation monitoring"@en .

###  http://ontogeo.kz/geodeticont-kz#GeodeticActivity
:GeodeticActivity rdf:type owl:Class ;
    rdfs:subClassOf :GeodeticWork ;
    skos:prefLabel "геодезическая деятельность"@ru ;
    skos:prefLabel "geodetic activity"@en .

###  http://ontogeo.kz/geodeticont-kz#ConstructionObject
:ConstructionObject rdf:type owl:Class ;
    rdfs:subClassOf :GeodeticEntity ;
    rdfs:subClassOf ifc:IfcProduct ;
    rdfs:subClassOf geo:SpatialObject ;
    skos:prefLabel "объект строительства"@ru ;
    skos:prefLabel "construction object"@en .

###  http://ontogeo.kz/geodeticont-kz#LinearInfrastructureObject
:LinearInfrastructureObject rdf:type owl:Class ;
    rdfs:subClassOf :ConstructionObject ;
    skos:prefLabel "линейный объект инфраструктуры"@ru ;
    skos:prefLabel "linear infrastructure object"@en .

###  http://ontogeo.kz/geodeticont-kz#RoadObject
:RoadObject rdf:type owl:Class ;
    rdfs:subClassOf :LinearInfrastructureObject ;
    skos:prefLabel "дорожный объект"@ru ;
    skos:prefLabel "road object"@en .

###  http://ontogeo.kz/geodeticont-kz#StructuralElement
:StructuralElement rdf:type owl:Class ;
    rdfs:subClassOf :ConstructionObject ;
    rdfs:subClassOf ifc:IfcBuildingElement ;
