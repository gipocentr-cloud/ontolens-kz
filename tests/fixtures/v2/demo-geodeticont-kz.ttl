    skos:prefLabel "instrument"@en .

###  http://ontogeo.kz/geodeticont-kz#AccuracyRequirement
:AccuracyRequirement rdf:type owl:Class ;
    rdfs:subClassOf :GeodeticEntity ;
    skos:prefLabel "требование точности"@ru ;
    skos:prefLabel "accuracy requirement"@en .

###  http://ontogeo.kz/geodeticont-kz#Tolerance
:Tolerance rdf:type owl:Class ;
    rdfs:subClassOf :AccuracyRequirement ;
    skos:prefLabel "допуск"@ru ;
    skos:prefLabel "tolerance"@en .

###  http://ontogeo.kz/geodeticont-kz#Deviation
:Deviation rdf:type owl:Class ;
    rdfs:subClassOf :GeodeticEntity ;
    skos:prefLabel "отклонение"@ru ;
    skos:prefLabel "deviation"@en .

###  http://ontogeo.kz/geodeticont-kz#Measurement
:Measurement rdf:type owl:Class ;
    rdfs:subClassOf :GeodeticEntity ;
    skos:prefLabel "измерение"@ru ;
    skos:prefLabel "measurement"@en .

###  http://ontogeo.kz/geodeticont-kz#RegulatoryDocument
:RegulatoryDocument rdf:type owl:Class ;
    rdfs:subClassOf :GeodeticEntity ;
    skos:prefLabel "нормативный документ"@ru ;
    skos:prefLabel "regulatory document"@en .

###  http://ontogeo.kz/geodeticont-kz#TechnicalReport
:TechnicalReport rdf:type owl:Class ;
    rdfs:subClassOf :RegulatoryDocument ;
